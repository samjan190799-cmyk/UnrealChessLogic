default_platform(:ios)

platform :ios do
  desc "Сборка и выгрузка билда в Apple TestFlight"
  lane :beta do
    # Настройка ключа App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # Автоматическая выгрузка собранного IPA в TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "Реализация 3D шахмат на UE5 с Chaos Physics и сенсорным управлением под iOS",
      distribute_external: false
    )
  end
end
