default_platform(:ios)

platform :ios do
  desc "Сборка iOS IPA и выгрузка в Apple TestFlight"
  lane :beta do
    setup_ci if is_ci

    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    team_id = ENV["DEVELOPMENT_TEAM"]
    bundle_id = "com.Antigravity.Chess3D"

    # 1. Авторизация через App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Автоматическое получение/генерация сертификатов и профилей для App Store
    get_certificates(api_key: api_key)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id
    )

    # 3. Сборка архива и генерация .ipa
    build_app(
      project: "iOS/Chess3D.xcodeproj",
      scheme: "Chess3D",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        teamID: team_id,
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          bundle_id => "match AppStore #{bundle_id}"
        }
      },
      output_directory: "build",
      output_name: "Chess3D.ipa",
      clean: true
    )

    # 4. Выгрузка собранного .ipa пакета в TestFlight
    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: "build/Chess3D.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Реализация 3D шахмат на UE5 с Chaos Physics и сенсорным управлением под iOS",
      distribute_external: false
    )
  end
end
