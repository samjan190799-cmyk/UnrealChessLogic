default_platform(:ios)

platform :ios do
  desc "Сборка iOS IPA и выгрузка в Apple TestFlight"
  lane :beta do
    # 1. Авторизация через App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    team_id = ENV["DEVELOPMENT_TEAM"]

    # 2. Сборка архива и генерация .ipa с авто-подписью Apple Developer Team
    build_app(
      project: "iOS/Chess3D.xcodeproj",
      scheme: "Chess3D",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        teamID: team_id,
        method: "app-store",
        signingStyle: "automatic",
        uploadSymbols: true,
        uploadBitcode: false
      },
      xcargs: "DEVELOPMENT_TEAM=#{team_id} -allowProvisioningUpdates",
      output_directory: "build",
      output_name: "Chess3D.ipa",
      clean: true
    )

    # 3. Выгрузка собранного .ipa пакета в TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/Chess3D.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Реализация 3D шахмат на UE5 с Chaos Physics и сенсорным управлением под iOS",
      distribute_external: false
    )
  end
end
