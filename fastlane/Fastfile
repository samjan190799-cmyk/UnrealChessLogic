default_platform(:ios)

platform :ios do
  desc "Сборка iOS IPA и выгрузка в Apple TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    team_id = ENV["DEVELOPMENT_TEAM"]
    bundle_id = "com.Antigravity.Chess3D"

    # 1. Авторизация через App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Сборка архива и генерация .ipa через xcodebuild с прямой авторизацией в App Store Connect
    build_app(
      project: "iOS/Chess3D.xcodeproj",
      scheme: "Chess3D",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        teamID: team_id,
        method: "app-store",
        signingStyle: "automatic",
        uploadSymbols: true,
        uploadBitcode: false
      },
      xcargs: "DEVELOPMENT_TEAM=#{team_id} -allowProvisioningUpdates -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id} -authenticationKeyPath #{key_path}",
      output_directory: "build",
      output_name: "Chess3D.ipa",
      clean: true
    )

    # 3. Выгрузка собранного .ipa пакета в TestFlight
    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: "build/Chess3D.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Реализация 3D шахмат на UE5 с Chaos Physics и сенсорным управлением под iOS",
      distribute_external: false
    )
  end
end
